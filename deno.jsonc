{
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ]
  },
  "exclude": [
    "docs/",
    "coverage/"
  ],
  "exports": {
    "./app": "./ui/flash_card_panel.tsx",
    "./core": "./core/mod.ts"
  },
  "imports": {
    "@core/iterutil": "jsr:@core/iterutil@^0.9.0",
    "@core/unknownutil": "jsr:@core/unknownutil@^4.3.0",
    "@cosense/std": "jsr:@cosense/std@^0.29.0",
    "@cosense/types": "jsr:@cosense/types@^0.10.1",
    "@progfay/scrapbox-parser": "jsr:@progfay/scrapbox-parser@^10.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/async": "jsr:@std/async@^1.0.5",
    "@std/collections": "jsr:@std/collections@^1.0.8",
    "@std/csv": "jsr:@std/csv@^1.0.3",
    "@std/html": "jsr:@std/html@^1.0.3",
    "@std/random": "jsr:@std/random@^0.1.0",
    "@std/testing": "jsr:@std/testing@^1.0.3",
    "option-t": "npm:option-t@^53.0.0",
    "preact": "npm:preact@^10.26.6",
    "ts-fsrs": "npm:ts-fsrs@^5.0.0"
  },
  "name": "@takker/cosense-srs",
  "tasks": {
    "check": {
      "command": "deno fmt --check && deno lint && deno publish --dry-run",
      "dependencies": [
        "type-check",
        "type-check",
        "doc:lint",
        "test"
      ]
    },
    "coverage": "deno test --allow-env --allow-read=./ --doc --parallel --shuffle --coverage && deno coverage --html",
    "doc": "deno doc --html ./core/mod.ts",
    "doc:lint": "deno doc --lint ./core/mod.ts",
    "fix": {
      "command": "deno fmt && deno lint --fix && deno publish --dry-run --allow-dirty",
      "dependencies": [
        "type-check",
        "doc:lint",
        "test"
      ]
    },
    "test": "deno test --allow-env --allow-read=./ --doc --parallel --shuffle --no-check",
    "type-check": "deno check --remote **/*.ts",
    // from https://github.com/jsr-core/unknownutil/blob/v4.2.2/deno.jsonc#L84-L85
    "update": "deno outdated --update"
  },
  "version": "0.0.0"
}
