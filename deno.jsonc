{
  "name": "@takker/cosense-srs",
  "version": "0.0.0",
  "exports": {
    "./core": "./core/mod.ts",
    "./app": "./ui/flash_card_panel.tsx"
  },
  "tasks": {
    "fix": "deno fmt && deno lint --fix && deno doc --lint ./core/mod.ts && deno test --allow-read=./ --doc --parallel --shuffle && deno publish --dry-run --allow-dirty",
    "check": "deno fmt --check && deno lint && deno doc --lint ./core/mod.ts && deno test --allow-read=./ --doc --parallel --shuffle && deno publish --dry-run",
    "coverage": "deno test --allow-read=./ --parallel --shuffle --coverage && deno coverage --html",
    // from https://github.com/jsr-core/unknownutil/blob/v4.2.2/deno.jsonc#L84-L85
    "update": "deno run --allow-env --allow-read --allow-write=. --allow-run=git,deno --allow-net=jsr.io,registry.npmjs.org jsr:@molt/cli",
    "update:commit": "deno task -q update --commit --prefix deps: --pre-commit=fix"
  },
  "exclude": [
    "docs/",
    "coverage/"
  ],
  "imports": {
    "@core/iterutil": "jsr:@core/iterutil@^0.9.0",
    "@core/unknownutil": "jsr:@core/unknownutil@^4.3.0",
    "@cosense/std": "jsr:@cosense/std@^0.29.0",
    "@cosense/types": "jsr:@cosense/types@^0.10.1",
    "@progfay/scrapbox-parser": "jsr:@progfay/scrapbox-parser@^9.1.5",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/async": "jsr:@std/async@^1.0.5",
    "@std/collections": "jsr:@std/collections@^1.0.8",
    "@std/csv": "jsr:@std/csv@^1.0.3",
    "@std/html": "jsr:@std/html@^1.0.3",
    "@std/random": "jsr:@std/random@^0.1.0",
    "@std/testing": "jsr:@std/testing@^1.0.3",
    "option-t": "npm:option-t@^49.2.0",
    "preact": "npm:preact@^10.24.3",
    "ts-fsrs": "npm:ts-fsrs@^4.3.1"
  }
}
